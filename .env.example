# Self-host configuration for docker-compose (one fire station = one deployment).
# Copy to .env and fill in the required secrets. Railway deploys ignore this file.
#
#   cp .env.example .env
#   docker compose up -d

# --- Required ---------------------------------------------------------------------
# Postgres password for the bundled db service (any strong value; used on first boot).
POSTGRES_PASSWORD=change-me-strong-password
# Signs JWTs — keep it STABLE (changing it logs everyone out).
# Generate: openssl rand -hex 32
AUTH_SECRET_KEY=
# Application secret (sessions/tokens). Also stable, also openssl rand -hex 32.
SECRET_KEY=
# Admin account created on first boot — at least 12 characters. Change it after the
# first login. Without it the backend refuses to start in production.
ADMIN_SEED_PASSWORD=
# Read-only account (wall displays, guests) — also at least 12 characters, also required:
# seeding refuses to fall back to a default viewer login on a real deployment.
VIEWER_PASSWORD=

# --- Version ----------------------------------------------------------------------
# Which published images to run: a pinned release (0.1.0), a minor series that follows
# patches (0.1), or the newest release (latest, the default). All four images share this
# one tag. Update with `docker compose pull && docker compose up -d`; roll back by pinning
# the previous version.
# Release notes: https://github.com/feuerwehr-oberwil/kp-rueck/releases
KP_RUECK_TAG=latest

# --- Networking -------------------------------------------------------------------
# Domain whose A/AAAA record points at this host. Set it and Caddy gets a TLS certificate
# automatically. Leave EMPTY to serve plain HTTP on HTTP_PORT for a trusted LAN.
DOMAIN=
# Host port for plain HTTP (ignored when DOMAIN is set and you use 80/443).
HTTP_PORT=8080
# Host port for HTTPS. Only worth changing if something else on this host already owns 443 —
# most commonly a KP Front stack alongside this one. See docs/RUNNING-BOTH.md.
HTTPS_PORT=443
# The deployment's own URL — the only allowed CORS origin. With a DOMAIN set this is
# https://<DOMAIN>; on a LAN it's http://<host>:<HTTP_PORT>.
# NOTE: this was called PUBLIC_URL until 0.2. That name still works, but it clashes with
# KP Front's PUBLIC_URL, which means something different there (the base for absolute links
# in outbound webhooks) — so copying one .env into the other broke CORS with no error
# message. If you run both, see docs/RUNNING-BOTH.md.
CORS_ORIGINS=http://localhost:8080
# Login cookies are Secure by default, which browsers only send over HTTPS. If you serve
# plain HTTP on a trusted LAN (no DOMAIN), set this to false — otherwise the login cookie
# is dropped and signing in fails with no visible error. Leave blank when using HTTPS.
AUTH_COOKIE_SECURE=

# The shared `editor` login is a development convenience and is never seeded in
# production — real editors come from SSO or are created by the admin.

# --- Database identity (optional; defaults shown) ----------------------------------
# POSTGRES_USER=kprueck
# POSTGRES_DB=kprueck

# --- Optional integrations (leave blank to disable) --------------------------------
# Divera 24/7 — inbound alarms, outbound alerting, roster sync.
# Get the key from Divera: Administration > Settings > Interfaces > API.
DIVERA_ACCESS_KEY=
# Traccar — vehicle GPS tracking and GPS-driven status automation.
TRACCAR_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
# Microsoft Entra ID login (omit to disable).
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# The generic alarm webhook (POST /api/alarms) works with ANY dispatch system and needs no
# vendor account. Set the shared secret here and it wins over the database — this is the
# scriptable way to provision a deployment. Generate: openssl rand -hex 24.
ALARM_WEBHOOK_SECRET=
# Leave it blank and the secret is auto-generated into the DB on first boot instead, and has
# to be read back out:
#   SELECT value FROM settings WHERE key = 'alarm_webhook_secret';
# See docs/ALARM-INTEGRATIONS.md.

# --- Thermal print agent (compose profile: printing) -------------------------------
# Shared secret, used at BOTH ends: the backend requires it, the agent sends it as
# X-Agent-Token. Empty = the agent endpoints are fail-closed (403), i.e. printing is off.
# Generate: openssl rand -hex 24.
PRINT_AGENT_TOKEN=
# The agent runs on the host network, so it can't use service names.
PRINT_AGENT_BACKEND_URL=http://localhost:8080
# Adaptive polling, in seconds: idle gap, and the brisk gap after a recent job.
# PRINT_POLL_INTERVAL_IDLE=60
# PRINT_POLL_INTERVAL_ACTIVE=5
# DRY_RUN=false
