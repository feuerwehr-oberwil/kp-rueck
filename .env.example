# Self-host configuration for docker-compose (one fire station = one deployment).
# Railway deploys ignore this file.
#
#   just init     # three decisions, and it writes a complete .env – secrets generated,
#                 # networking derived. It refuses to overwrite an existing .env.
#   just up       # starts the stack, waits until it answers, prints the URL
#
# Prefer to do it by hand? `cp .env.example .env`, work through the Required section below,
# then `docker compose up -d`. Nothing under "everything below is optional" is needed to
# get a board running.

# ####################################################################################
# ### REQUIRED – the whole section. A first install is these values and nothing else. #
# ####################################################################################
#
# Two answers decide the three networking lines at the end of this section:
#   (a) a domain points at this host → DOMAIN=kp.example.ch  HTTP_PORT=80    CORS_ORIGINS=https://kp.example.ch
#   (b) LAN only, no domain          → DOMAIN=               HTTP_PORT=8080  CORS_ORIGINS=http://<this-host>:8080
# `just init` fills all of this in for you from one question – you only need this section
# if you are editing the file by hand.

# --- The five secrets ---
# Postgres password for the bundled db service (any strong value; used on first boot).
# Left EMPTY on purpose, like the other four: compose refuses to start until you fill it in.
# It used to ship a working-looking placeholder, and in a file where every other required line
# is blank, a filled line reads as one already done. Unlike the two signing keys, nothing here
# rejects a weak value for you.
POSTGRES_PASSWORD=
# Signs JWTs – keep it STABLE (changing it logs everyone out).
# Generate: openssl rand -hex 32
AUTH_SECRET_KEY=
# Application secret (sessions/tokens). Also stable, also openssl rand -hex 32.
SECRET_KEY=
# Admin account – this one and VIEWER_PASSWORD below are the two of the five that MAY stay
# empty; the three values above may not. Empty, the board boots "unclaimed": the first
# browser visit sets the admin password and the station name at /setup. Filled (at least
# 12 characters), the account is created on first boot and the wizard is pre-answered –
# which is what `just init` writes. Change it after the first login.
ADMIN_SEED_PASSWORD=
# Read-only account (wall displays, guests) – same rule: empty = set in the browser at
# /setup, filled (at least 12 characters) = created on first boot. Once filled in, this value
# is re-applied from .env on EVERY boot – rotate it here, not in the app (docs/SETUP.md §2).
VIEWER_PASSWORD=

# --- The three networking lines ---
# These are as required as the secrets above, and they are where first installs go wrong:
# get CORS_ORIGINS wrong and the board loads perfectly while every request behind it fails.
#
# Domain whose A/AAAA record points at this host. Set it and Caddy gets a TLS certificate
# automatically. Leave EMPTY to serve plain HTTP on HTTP_PORT for a trusted LAN.
DOMAIN=
# Host port for plain HTTP. This is the host side of "${HTTP_PORT:-8080}:80" in
# docker-compose.yml, so it is NOT ignored once DOMAIN is set – it decides whether anything
# on this host listens on port 80 at all. With a domain, set it to 80: left at 8080,
# http://kp.example.ch is refused outright and Let's Encrypt's HTTP-01 challenge has nothing
# to answer on. Leave it at 8080 on a LAN, or when another stack on this box already owns
# port 80 – see docs/RUNNING-BOTH.md.
HTTP_PORT=8080
# The deployment's own URL – the only allowed CORS origin. With a DOMAIN set this is
# https://<DOMAIN>; on a LAN it's http://<host>:<HTTP_PORT>. It must match how browsers
# actually reach the board, character for character (scheme and port included).
# It now decides one more thing on your behalf: if it is plain http://, the backend serves
# login cookies without the Secure flag, because a browser drops a Secure cookie over http://
# and signing in then fails with no visible error. See AUTH_COOKIE_SECURE further down.
# It may hold several comma-separated origins, but do NOT mix http:// and https:// in it: one
# https:// entry anywhere in the list makes the backend serve Secure login cookies again, and
# browsers on the plain-HTTP address then fail to sign in with nothing on screen to explain it.
# One origin is the normal answer.
# NOTE: this was called PUBLIC_URL until 0.2. That name still works, but it clashes with
# KP Front's PUBLIC_URL, which means something different there (the base for absolute links
# in outbound webhooks) – so copying one .env into the other broke CORS with no error
# message. If you run both, see docs/RUNNING-BOTH.md.
CORS_ORIGINS=http://localhost:8080

# ####################################################################################
# ### --- Everything below is optional --- ###########################################
# ###                                                                                #
# ### Sensible defaults, except for one: read the BACKUP_HOST_DIR note before you    #
# ### rely on the nightly backup. Skip the rest on evening one and come back later.  #
# ####################################################################################

# --- Version ----------------------------------------------------------------------
# Which published images to run: a pinned release (X.Y.Z), a minor series that follows
# patches (X.Y), or the newest release (latest, the default). All four images share this
# one tag. Update with `docker compose pull && docker compose up -d`; roll back by pinning
# the previous version.
# Release notes: https://github.com/feuerwehr-oberwil/kp-rueck/releases
KP_RUECK_TAG=latest

# --- Backups (compose profile: backup) ----------------------------------------------
# It writes a verified Postgres dump AND the Reko photo volume – the photos are not in the
# database, so a dump alone restores a complete record pointing at missing images.
#
# Leave this set. It is what makes the backup sidecar part of the normal stack, and the
# reason it is not simply `--profile backup` on the command line is that the flag has to be
# remembered EVERY time: `just down` is a plain `docker compose down`, and the documented update
# path is a plain `docker compose up -d`. Either one without the profile quietly leaves the sidecar
# uncreated – and a container that does not exist cannot report itself unhealthy, so the
# one signal that backups have stopped is missing precisely when backups have stopped.
# Setting it here applies it to every compose command in this directory.
COMPOSE_PROFILES=backup
#
# Where the files land ON THE HOST. READ THIS ONE. The default below is `./backups`, i.e.
# inside this checkout, on the SAME DISK as the database – which is a copy, not a backup.
# The disk that takes the database down takes it with it, and you will find that out on the
# day you need it. Point it at anything that is not this disk – a second drive, a NAS mount,
# a USB stick:
#   BACKUP_HOST_DIR=/mnt/backup/kp-rueck
# It is deliberately a host path and not a docker volume: `docker compose down -v` must not be
# able to take the backups with it, and you have to be able to copy them off this box without
# docker.
BACKUP_HOST_DIR=./backups
# Time of day (24h, container's timezone) for the nightly run.
BACKUP_AT=03:30
# Retention, in two series, because they answer two different questions: 14 dailies are "undo
# last night" (two weeks, because a volunteer brigade has no daily operator and damage done at
# a Saturday exercise can go unnoticed until the drill after next), 8 weeklies are "someone
# imported the wrong roster five weeks ago". Weeklies are hardlinks to the daily they were
# promoted from, so they cost nothing until that daily is pruned. The dumps are small
# (single-digit MB for a station); the photos decide your disk usage.
# The full argument is in docs/DEPLOYMENT.md §6.
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# The backup runs pg_dump from this image. It MUST be the same Postgres major version as the
# db service or newer – pg_dump refuses to dump a server newer than itself. Change it in the
# same commit in which you change the db image, never separately.
BACKUP_PG_IMAGE=postgres:16-alpine

# --- Networking, the rest -----------------------------------------------------------
# Host port for HTTPS. Only worth changing if something else on this host already owns 443 –
# most commonly a KP Front stack alongside this one. See docs/RUNNING-BOTH.md.
HTTPS_PORT=443
# Login cookies carry the Secure flag, which means browsers only send them over HTTPS. You
# should not need to touch this: when CORS_ORIGINS is plain http:// the backend drops the flag
# by itself and logs a warning saying so. That inference exists because requiring this variable
# is what made a shipped trusted-LAN install impossible to log into out of the box – the
# browser discards the cookie silently, and the failure looks like "the password is wrong".
# Set it explicitly only to override that reading, in either direction: `true` when TLS is
# terminated somewhere the backend cannot see (so CORS_ORIGINS says https:// anyway, and this
# is redundant), `false` to force plain cookies on a deployment whose origin says https://.
# Blank = let the backend decide.
AUTH_COOKIE_SECURE=

# How many reverse proxies sit in front of the backend. Decides which X-Forwarded-For entry
# is believed – the caller writes the left of that header, our own proxies append to the
# right – and that value keys the login throttle, the request rate limit and the IP in the
# audit trail. The default of 1 is correct for both supported deployments (Caddy in this
# compose stack; Railway's edge on Railway). Only change it if you put another proxy in
# front (then 2), or expose the backend directly with none at all (then 0, which makes the
# header be ignored entirely). Too HIGH is the unsafe direction: it starts trusting entries
# the caller wrote.
TRUSTED_PROXY_COUNT=1

# The shared `editor` login is a development convenience and is never seeded in
# production – real editors come from SSO or are created by the admin.

# --- Deployment role (optional; default production) --------------------------------
# What this instance may do to the OUTSIDE world. Leave it blank on the deployment people
# actually use. Set it to `staging` on a second instance you test on – especially one running
# on a copy of the real database, because the copy brings `alerting.enabled` and
# `railway_database_url` along with it, still pointing outward. That is the whole reason this
# is an environment variable and not a setting: a database dump cannot reach it.
#
# `staging` refuses exactly two things, loudly (403 with a reason, never a silent no-op):
#   - outbound alerting (Ausalarmierung), whatever `alerting.enabled` says
#   - sync to another instance (`railway_database_url` reads as empty, the job never starts)
# ...and shows a permanent band reading "Staging – Übungssystem" on every page.
# Deliberately NOT blocked: printing, GPS reads, inbound alarms, everything else.
#
# Unset or empty reads as `production` and blocks nothing. `production` and `staging` are the
# ONLY accepted values – anything else (a misspelt `stagging`, say) makes the backend refuse to
# start, with an error naming the value and the valid ones. That is on purpose: an unset variable
# means nobody made a claim, but a set one means somebody meant something specific, and a value
# we cannot read must not be guessed as the reading that lifts every lock.
# See docs/RAILWAY.md §5.1.
DEPLOYMENT_ROLE=

# --- Online map tiles ---------------------------------------------------------------
# CARTO Voyager and Dark Matter require a browser API key. Keep the real value only in this
# gitignored `.env`; the frontend reads it at runtime and appends it to CARTO tile requests.
# OSM, Esri topo, and the self-hosted offline tiles do not use it.
CARTO_API_KEY=

# --- Database identity (optional; defaults shown) ----------------------------------
# POSTGRES_USER=kprueck
# POSTGRES_DB=kprueck

# --- Offline map tiles ---------------------------------------------------------------
# The filename of the .mbtiles set on the tileserver volume. Read from THIS file by both
# docker-compose.yml (it passes the name into the tileserver container) and `just doctor` /
# `just tiles-status`, which use it to tell real offline tiles apart from the ~100 KB
# bootstrap placeholder. Leave it alone on a deployment that already has tiles: renaming it
# makes the init script find nothing and quietly write a placeholder instead – a map that
# looks fine and contains nothing. Only worth setting on a fresh stack.
# TILES_NAME=basel-landschaft
#
# YOUR REGION IS NOT SET HERE. The four variables that decide what gets rendered are read by
# scripts/download-tiles.sh from the shell it is started in, not from this file – put them in
# .env and the next `just tiles-download` will spend fifteen minutes cheerfully generating
# Basel-Landschaft again. Pass them on the command line (docs/SETUP.md §4 has the copy-paste
# block) and keep that line in a wrapper script, because nothing on the server remembers it:
#
#   TILES_REGION    label shown in the script output and `just tiles-status`; cosmetic.
#                   Default: Basel-Landschaft
#   TILES_BOUNDS    minLon,minLat,maxLon,maxLat – the area actually rendered. The one that
#                   matters. Draw yours at https://boundingbox.klokantech.com/ (CSV output)
#                   and be generous at the edges. Default: 7.4,47.4,7.9,47.7
#   TILES_AREA      planetiler's area name for the auxiliary data it fetches; keep it
#                   consistent with the extract. Default: switzerland
#   TILES_PBF_URL   the OSM extract, from https://download.geofabrik.de/ – take the SMALLEST
#                   one covering your area. Default: the whole of Switzerland
#
# See docs/OFFLINE_MAPS.md, "Using Custom Regions".

# --- Optional integrations (leave blank to disable) --------------------------------
# Divera 24/7 – inbound alarms, outbound alerting, roster sync.
# Get the key from Divera: Administration > Settings > Interfaces > API.
DIVERA_ACCESS_KEY=
# Traccar – vehicle GPS tracking and GPS-driven status automation.
TRACCAR_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
# Microsoft Entra ID login (omit to disable).
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# The generic alarm webhook (POST /api/alarms) works with ANY dispatch system and needs no
# vendor account. Set the shared secret here and it wins over the database – this is the
# scriptable way to provision a deployment. Generate: openssl rand -hex 24.
ALARM_WEBHOOK_SECRET=
# Leave it blank and the secret is auto-generated into the DB on first boot instead. An admin can
# then read it back, and rotate it, from inside the app – no database shell:
#   GET  /api/settings/alarm-webhook-secret          (shows it, and whether it came from env or db)
#   POST /api/settings/alarm-webhook-secret/rotate   (issues a new one)
# Rotating is refused with a 409 while THIS line is filled in, because this line wins: a rotation
# would change a value nobody reads, and you would hand your dispatcher a secret that rejects
# every alarm. Change a pinned secret here and restart the backend.
# See docs/ALARM-INTEGRATIONS.md.

# --- Records, retention and access control ------------------------------------------
# How long the audit log is kept, in days. 0 (the default) means KEEP EVERYTHING: the audit
# trail is the record that backs an after-action report, and pruning it on a timer nobody
# configured is not a default we want to make for your fire service. Earlier versions
# defaulted to 90 days.
# Set a positive number if your retention policy says to prune. A public demo caps at 7 days
# regardless. The sweep runs every AUDIT_CLEANUP_INTERVAL_HOURS and deletes in batches.
AUDIT_RETENTION_DAYS=0
# AUDIT_CLEANUP_INTERVAL_HOURS=24

# Who gets write access via Microsoft Entra ID. ANY member of your tenant can reach the login,
# so editor rights are an explicit grant: comma-separated e-mail addresses (case-insensitive)
# that get role=editor on first Microsoft login. Everyone else is provisioned as a viewer.
# Leave blank and SSO users are all viewers – safe, and probably not what you want.
SSO_EDITOR_ALLOWLIST=

# Reject WebSocket connections that carry no valid login cookie. Default true.
# The live board pushes incidents, addresses and crew assignments over this socket, and
# without it anything that can reach /socket.io can subscribe without logging in – the CORS
# whitelist only stops browsers, not a script. Set to false ONLY to unblock a client that
# genuinely cannot log in, and expect the board to keep working either way: it falls back to
# ~5s polling when the socket is unavailable.
# WS_REQUIRE_AUTH=true

# Brute-force protection on the login form. Per-USERNAME failure counting (not per-IP), so a
# command post behind one NAT can't lock itself out. Defaults shown.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_FAILED_LOCKOUT_SECONDS=300
# LOGIN_FAILED_WINDOW_SECONDS=900
# LOGIN_RATE_LIMIT_PER_IP=30/minute

# Bypass token for API access without a login, for scripted configuration. Empty = disabled,
# which is the default and the right answer for almost everyone. If you set it, treat it as a
# password equivalent: it is not scoped to a user and does not appear in the audit trail as
# one. Generate: openssl rand -hex 32
MASTER_TOKEN=

# --- Thermal print agent (compose profile: printing) -------------------------------
# Shared secret, used at BOTH ends: the backend requires it, the agent sends it as
# X-Agent-Token. Empty = the agent endpoints are fail-closed (403), i.e. printing is off.
# Generate: openssl rand -hex 24.
PRINT_AGENT_TOKEN=
# Where the agent finds the backend. It runs on the host network, so it can't use a service
# name – but the trap is the hostname, not the network. Caddy has ONE site block, keyed on
# DOMAIN, so a request arriving as `Host: localhost` matches no site and comes back 404, which
# reads exactly like a rejected token. SET THIS TO THE SAME URL AS CORS_ORIGINS. The
# localhost default below is only right on a LAN install: empty DOMAIN, HTTP_PORT still 8080.
PRINT_AGENT_BACKEND_URL=http://localhost:8080
# The agent long-polls: the backend holds the request open until a job is queued, so a slip
# prints within milliseconds. These are the fallback pace only (printing switched off, or an
# older backend), in seconds. PRINT_LONG_POLL_SEC is how long the backend is asked to hold.
# PRINT_POLL_INTERVAL_IDLE=10
# PRINT_POLL_INTERVAL_ACTIVE=5
# PRINT_LONG_POLL_SEC=25
# DRY_RUN=false

# --- Fehlerberichte / telemetry (opt-in, default OFF) -------------------------------
# Nothing is transmitted until an admin switches it on in Einstellungen → Fehlerberichte –
# see PRIVACY.md. This variable is the DEPLOYER's veto and outranks that switch: set it to 0
# and the forwarder is compiled out of the process, so no later click can enable it.
KP_TELEMETRY_ENABLED=1
# Where opted-in reports go. Defaults to the maintainer's ingest (a public, write-only Sentry
# key – see backend/app/telemetry/dsn.py). Point it at your own GlitchTip to keep reports
# in-house, or blank it for the same effect as KP_TELEMETRY_ENABLED=0.
KP_TELEMETRY_DSN=
