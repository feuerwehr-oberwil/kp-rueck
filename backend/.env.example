DATABASE_URL=postgresql+asyncpg://kprueck:kprueck@localhost:5433/kprueck
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional overrides
# API_V1_PREFIX=/api
# PROJECT_NAME=KP Rück API
# HOST=0.0.0.0
# PORT=8000
# RELOAD=true

# Authentication (all with AUTH_ prefix)
# AUTH_BYPASS_DEV=true  # DEVELOPMENT ONLY: Bypass authentication (returns mock editor user)
# AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15  # JWT access token lifetime (default: 15 minutes)
# AUTH_SECRET_KEY=your-secret-key-here  # Generate with: openssl rand -hex 32

# Microsoft Entra ID Login (optional - omit to disable)
# MICROSOFT_CLIENT_ID=<from Azure App Registration>
# MICROSOFT_TENANT_ID=<from Azure App Registration>
# MICROSOFT_CLIENT_SECRET=<client secret VALUE, not the Secret ID!>
# MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Alarm intake ---
# Generic alarm webhook (POST /api/alarms) — works with ANY dispatch system, no
# vendor account needed. Its shared secret is NOT set here: it is auto-generated
# and stored in the DB settings table (key `alarm_webhook_secret`) on first boot.
#   Read it:  SELECT value FROM settings WHERE key = 'alarm_webhook_secret';
# See docs/ALARM-INTEGRATIONS.md. The Divera adapter below is one optional source.

# Divera 24/7 (optional) — inbound alarm webhook/polling, outbound alerting, roster sync.
# Polling only runs when users are connected via WebSocket - avoids API abuse.
# DIVERA_ACCESS_KEY=your-divera-api-key  # Get from Divera: Administration > Settings > Interfaces > API
# DIVERA_API_URL=https://app.divera247.com/api/v2  # Default Divera API URL
# DIVERA_POLL_INTERVAL_SECONDS=30  # How often to poll when users are connected (default: 30)
# DIVERA_POLL_MAX_ALARMS=50  # Max alarms to fetch per poll (default: 50)

# Traccar (optional) — vehicle GPS tracking + GPS-driven status automation.
# TRACCAR_URL=https://gps.example.com
# TRACCAR_EMAIL=account@example.com
# TRACCAR_PASSWORD=your-traccar-password

# Print agent (optional) — shared secret for the pull-based print agent.
# Sent by the agent as the X-Agent-Token header. Leave unset only for
# isolated LAN installs; ALWAYS set it for a cloud-hosted backend.
# See docs/PRINT_AGENT.md.
# PRINT_AGENT_TOKEN=generate-a-long-random-string
