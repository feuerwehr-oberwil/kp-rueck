{
  "name": "kp-rueck-frontend",
  "version": "0.9.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:dead": "knip && jscpd .",
    "typecheck": "tsc --noEmit",
    "openapi:types": "openapi-typescript ../docs/openapi.json --default-non-nullable false -o lib/api/schema.d.ts",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "overflow-scan": "node scripts/overflow-scan.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "^4.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^1.75.0",
    "maplibre-gl": "^6.19.0",
    "next": "15.5.29",
    "next-intl": "^4.15.1",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-map-gl": "^8.1.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jscpd": "5.4.3",
    "jsdom": "^31.0.1",
    "knip": "6.48.0",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "// overrides": "Transitive advisories our direct deps still pin. Each target is bounded to the same major as the vulnerable version, so this closes the CVE without a breaking upgrade. Drop an entry once the parent ships a fixed range on its own.",
    "// @parcel/watcher": "Only used by next-intl message extraction. Our catalogs are checked in and next.config.mjs supplies the request-config alias directly. Omit this unused dependency and its vulnerable picomatch (GHSA-fc5q-39xc-vjpf).",
    "overrides": {
      "next-intl@4>@parcel/watcher": "-",
      "postcss@8": ">=8.5.18 <9",
      "brace-expansion@1": ">=1.1.21 <2",
      "brace-expansion@5": ">=5.0.12 <6",
      "js-yaml@4": ">=4.3.2 <5",
      "nanoid@3": ">=3.3.18 <4",
      "undici@7": ">=7.28.0 <8",
      "undici@8": ">=8.10.2 <9",
      "ws@8": ">=8.21.0 <9",
      "sharp": ">=0.35.5 <1",
      "source-map-js@1": ">=1.2.2 <2"
    }
  }
}
