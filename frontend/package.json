    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "// overrides": "Transitive advisories our direct deps still pin. Each target is bounded to the same major as the vulnerable version, so this closes the CVE without a breaking upgrade. Drop an entry once the parent ships a fixed range on its own.",
