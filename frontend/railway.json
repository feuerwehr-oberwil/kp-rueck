{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS",
    "sleepApplication": false,
    "startCommand": "node server.js",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  }
}
