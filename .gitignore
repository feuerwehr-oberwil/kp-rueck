.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
# ruff and mypy each drop a self-ignoring .gitignore INSIDE their own cache directory, so
# these look unnecessary right until you run the tool from a different cwd or hit a version
# that stops writing that file. Then the cache shows up in git status.
.ruff_cache/
.mypy_cache/
backend/.env
backend/env/
backend/venv/
backend/.venv/

# Playwright
playwright-report/
test-results/
*.html.report

# Die Ein-Datei-Variante der Landingpage wird gebaut, nicht eingecheckt.
site/dist/

# Interne Arbeitsdokumente: bleiben lokal, gehören nicht ins öffentliche Repo.
# (Gleiche Politik wie kp-front — Audits, Kritiken, Pläne, Pitches, QA-Protokolle.)
.claude/
docs/AUDIT-*.md
docs/AUDIT_*.md
docs/CRITIQUE-*.md
docs/UI_UX_FIXES.md
docs/TODO.md
docs/DEMO_PLAN.md
docs/FEEDBACK_*.md
docs/verify-polling.md
docs/118-magazin-statement.md
docs/research/
FEEDBACK-PLAN.md
ALARM-WEBHOOK-TEST-PROTOCOL.md
GPS-TEST-PROTOCOL.md

# Sicherungen. scripts/backup.sh schreibt standardmässig hierhin; auf einem Server gehören
# sie ohnehin ausserhalb des Repos (z. B. /var/backups/kp-rueck).
/backups/

# Persönliche Betriebsskripte gegen die PRODUKTIV-Datenbank. Standen vorher nur in
# .git/info/exclude — das ist maschinenlokal und schützt genau einen Klon. Hier stehen sie
# portabel. (check-logins.sh liest Login-Ereignisse inkl. Benutzernamen und IP-Adressen.)
/check-logins.sh

# Help screenshots are GENERATED (frontend/tests/capture-help-screenshots.spec.ts) and are not
# committed. The previous batch was 3.4 MB of PNGs that NO page referenced, shipped in every
# frontend image, showing a UI two design-system refactors out of date. Regenerate when the
# help page actually renders them, and commit only what it uses.
frontend/public/help/images/

# The print agent has no required dependencies (the core is stdlib) and its image installs
# with `uv pip install`, not from a lock. `uv run` still drops a lock here — a byproduct, not
# a pinned input. The backend's uv.lock IS committed; this one deliberately is not.
tools/print-agent/uv.lock

# Internal working documents: feature/hardening plans stay local (docs/README.md
# "Not in this repository"). They are point-in-time snapshots and go stale fast.
docs/plans/

# Runtime photo uploads. Reko and Schadenplatz photos land here at runtime and
# are operational data, not source: a real incident scene reached this PUBLIC
# repo on 2026-08-09 and had to be purged from history. Nothing under
# backend/data/ belongs in git — the directory is created on boot.
backend/data/
