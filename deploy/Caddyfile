# The single origin in front of the KP Rück stack.
#
# DOMAIN comes from .env. Set it to a hostname (its A/AAAA record pointing here, ports 80+443
# open) and Caddy fetches a certificate automatically — Let's Encrypt / ZeroSSL, no manual cert
# work. Leave it empty and it falls back to `:80`, plain HTTP for a trusted LAN.
# Optional: add `email you@example.com` to the global block below to register an ACME account.
#
# One origin is what keeps the published frontend image generic: the browser only ever talks to
# its own host, so nothing about this station is baked into the image at build time.
{
	# TRUSTED_PROXIES (from .env) names the proxy in front of this Caddy, if there is one –
	# addresses or CIDRs, space-separated. Caddy then keeps that proxy's X-Forwarded-For
	# instead of replacing it, and the backend's TRUSTED_PROXY_COUNT=2 can find the real
	# caller. Empty (the default) trusts nobody: the header starts here, as with no outer proxy.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES}
	}
}

# The routes, once. Both sites below serve the same board; they differ only in what they do
# with the X-Local-Autologin header, so the routing must not be able to drift between them.
(kp_board) {
	encode zstd gzip

	# 25 MiB Excel imports and 10 MiB photos fit, including multipart overhead.
	# The Next proxy independently enforces this for deployments without Caddy.
	request_body {
		max_size 32MiB
	}

	# Live board updates (Socket.IO). Must reach the backend directly — a WebSocket upgrade
	# can't go through the Next.js /backend-api proxy route, which is HTTP-only.
	handle /socket.io/* {
		reverse_proxy backend:8000
	}

	# The REST API, direct. The app itself goes through Next's /backend-api proxy, but
	# inbound integrations (alarm webhooks, the print agent, the intake form) post here.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Backend liveness, handy for uptime monitoring from outside.
	handle /health {
		reverse_proxy backend:8000
	}

	# Offline map tiles. The frontend requests /tiles/... on its own origin (lib/env.ts
	# getTileBaseUrl) so no second host and no CSP exception are needed.
	#
	# The prefix is stripped here because TileServer GL serves everything at the root
	# (/styles, /data, /fonts). The URLs it writes back INTO the style.json are a separate
	# problem, solved on the other side: the tileserver runs with TILES_PUBLIC_URL=/tiles/
	# (docker-compose.yml → scripts/init-tileserver.sh), so its vector source, glyph and
	# sprite self-references point back through this route instead of at the bare root.
	handle_path /tiles/* {
		reverse_proxy tileserver:8080
	}

	# Everything else is the Next.js app.
	handle {
		reverse_proxy frontend:3000
	}
}

{$DOMAIN} {
	# The public site, reachable from the LAN, a VPN or the internet. It DELETES
	# X-Local-Autologin from every incoming request, so no client out there can claim to be
	# the station machine — whatever they send is gone before any handler sees it, and
	# POST /api/auth/local-login can only ever answer 403 from here.
	#
	# This strip is half of the feature's security; the loopback bind below is the other half.
	# Never move it into a `handle` block: it has to cover /api/*, the Next /backend-api proxy
	# and anything added later, without anyone having to remember.
	request_header -X-Local-Autologin

	import kp_board
}

# The station's own machine, passwordless (optional — off unless LOCAL_AUTOLOGIN_USER and
# LOCAL_AUTOLOGIN_SECRET are set in .env; see docs/DEPLOYMENT.md §10).
#
# docker-compose.yml publishes this listener on 127.0.0.1 ONLY, which is the whole trust
# boundary: a request can reach it just from the host the stack runs on. In exchange it stamps
# the shared secret onto every upstream request, which is how the backend tells a request that
# came through here from one that merely reached it on the compose network.
#
# The port INSIDE the container is fixed, like :80 above; LOCAL_PORT in .env moves the host
# side of the mapping. A bare `:port` address also means Caddy serves it over plain HTTP and
# asks for no certificate — correct, since nothing but loopback can connect. With the feature
# off the header is empty and this is simply a second address for the ordinary board, login
# form and all.
:8081 {
	request_header X-Local-Autologin "{$LOCAL_AUTOLOGIN_SECRET}"

	import kp_board
}
